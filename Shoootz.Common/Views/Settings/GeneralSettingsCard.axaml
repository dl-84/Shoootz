<UserControl x:Class="Shoootz.Common.Views.Settings.GeneralSettingsCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:extensions="using:Shoootz.Common.Extensions"
             xmlns:models="using:Shoootz.Common.Models.Language"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:CompileBindings="False">

    <Border Classes="card">
        <StackPanel Spacing="{DynamicResource SpacingMedium}">

            <TextBlock Classes="h4"
                       Text="{extensions:Localization GeneralSettings}" />

            <Grid ColumnDefinitions="Auto,*">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageOption}"
                          Width="170">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:LanguageOptionModel">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingSmall}"
                                        VerticalAlignment="Center">
                                <Image AutomationProperties.AccessibilityView="Raw"
                                       Height="24"
                                       Source="{Binding Flag}"
                                       VerticalAlignment="Center"
                                       Width="40" />
                                <TextBlock Text="{Binding CultureInfo.NativeName}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource SpacingMedium}">
                    <Border Classes="icon-action"
                            Padding="6"
                            PointerPressed="OnCommandIconPressed"
                            Tag="{Binding OpenSettingsFolderCommand}"
                            ToolTip.HorizontalOffset="0"
                            ToolTip.Placement="TopEdgeAlignedRight"
                            ToolTip.Tip="{extensions:Localization OpenFolder}"
                            ToolTip.VerticalOffset="-2"
                            VerticalAlignment="Center">
                        <Path Data="{DynamicResource FolderOpenOutlineIcon}"
                              Height="16"
                              Width="16" />
                    </Border>
                    <Border Classes="icon-action"
                            Padding="6"
                            PointerPressed="OnCommandIconPressed"
                            Tag="{Binding ShowSettingsContentCommand}"
                            ToolTip.HorizontalOffset="0"
                            ToolTip.Placement="TopEdgeAlignedRight"
                            ToolTip.Tip="{extensions:Localization ShowSettings}"
                            ToolTip.VerticalOffset="-2"
                            VerticalAlignment="Center">
                        <Path Data="{DynamicResource FileTextOutlineIcon}"
                              Height="16"
                              Width="16" />
                    </Border>
                    <Border Classes="icon-action icon-danger"
                            Padding="6"
                            PointerPressed="OnCommandIconPressed"
                            Tag="{Binding DeleteSettingsFileCommand}"
                            ToolTip.HorizontalOffset="0"
                            ToolTip.Placement="TopEdgeAlignedRight"
                            ToolTip.Tip="{extensions:Localization DeleteSettingsFile}"
                            ToolTip.VerticalOffset="-2"
                            VerticalAlignment="Center">
                        <Path Data="{DynamicResource FileXOutlineIcon}"
                              Height="16"
                              Width="16" />
                    </Border>
                    <Border Classes="icon-action icon-danger"
                            Padding="6"
                            PointerPressed="OnCommandIconPressed"
                            Tag="{Binding DeleteSettingsFolderCommand}"
                            ToolTip.HorizontalOffset="0"
                            ToolTip.Placement="TopEdgeAlignedRight"
                            ToolTip.Tip="{extensions:Localization DeleteAll}"
                            ToolTip.VerticalOffset="-2"
                            VerticalAlignment="Center">
                        <Path Data="{DynamicResource TrashOutlineIcon}"
                              Height="16"
                              Width="16" />
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>

</UserControl>
