<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Shoootz.Common</AssemblyName>
    <RootNamespace>Shoootz.Common</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>SA0001;SA1309;SA1101;SA1200;SA1633;SA1000;SA1009;SA1010;SA1111;SA1502;SA1313;SA1303;SA1311;SA1600;CS2002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Update="Resources\Lang\Messages.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>Resources\Lang\Messages.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Shoootz.Common.Resources.Lang</StronglyTypedNamespace>
      <StronglyTypedClassName>Messages</StronglyTypedClassName>
    </EmbeddedResource>
    <Compile Update="Resources\Lang\Messages.Designer.cs">
      <DependentUpon>Messages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Library\Avalonia\Controls\ContentDialog\ContentDialog.csproj" />
    <ProjectReference Include="..\..\Library\Avalonia\Controls\InfoDialog\InfoDialog.csproj" />
    <ProjectReference Include="..\..\Library\Avalonia\Controls\LicenseTable\LicenseTable.csproj" />
    <ProjectReference Include="..\..\Library\Avalonia\Controls\TextEditor\TextEditor.csproj" />
    <ProjectReference Include="..\..\Library\Avalonia\Controls\WaitingDialog\WaitingDialog.csproj" />
    <ProjectReference Include="..\..\Library\C#\Result\Result.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\stylecop.json" Visible="false" />
  </ItemGroup>

  <Target Name="FormatCode" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="dotnet csharpier format ." WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec
      Command="dotnet xstyler --recursive --directory $(MSBuildProjectDirectory)"
      WorkingDirectory="$(MSBuildProjectDirectory)"
    />
  </Target>
</Project>
