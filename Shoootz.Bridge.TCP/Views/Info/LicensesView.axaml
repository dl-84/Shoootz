<UserControl x:Class="Shoootz.Bridge.TCP.Views.Info.LicensesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:Controls.LicenseTable"
             xmlns:extensions="using:Shoootz.Common.Extensions"
             xmlns:vm="using:Shoootz.Bridge.TCP.ViewModels.Info"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:LicensesViewModel">

    <Grid Margin="16,0,16,16"
          RowDefinitions="Auto,*">

        <TextBlock Classes="h3"
                   Margin="0,0,0,16"
                   Text="{extensions:Localization Licenses}" />

        <controls:LicenseTableControl Grid.Row="1"
                                      Headers="{Binding ColumnHeaders}"
                                      Items="{Binding Packages}" />

    </Grid>

</UserControl>
