<Window x:Class="Shoootz.Bridge.TCP.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:extensions="using:Shoootz.Common.Extensions"
        xmlns:types="clr-namespace:Shoootz.Bridge.TCP.Views.Types"
        xmlns:vm="using:Shoootz.Bridge.TCP.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:DataType="vm:MainWindowViewModel"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="{OnPlatform Default=True,
                                                       Linux=False}"
        Height="405"
        Icon="/Assets/Logo.png"
        Title="Shoootz TCP Bridge"
        Width="960"
        WindowDecorations="Full"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <Grid Background="{DynamicResource AppBackgroundAltBrush}"
              ColumnDefinitions="220,*"
              RowDefinitions="Auto,*">

            <Border x:Name="NavBorder"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    Background="{DynamicResource NavigationBackgroundBrush}"
                    Padding="{OnPlatform Default=0,
                                         macOS='0,33,0,0'}">
                <ListBox x:Name="NavList"
                         Classes="nav"
                         ItemContainerTheme="{DynamicResource NavigationItem}"
                         Margin="{DynamicResource MarginTopMedium}"
                         SelectionChanged="OnNavSelectionChanged">

                    <ListBoxItem Classes="navigation-header"
                                 IsEnabled="False">
                        <TextBlock Margin="20,16,20,4"
                                   Text="{extensions:Localization General,
                                                                  ToUpper=True}" />
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static types:NavigationPageType.General}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">
                            <Viewbox Height="18"
                                     VerticalAlignment="Center"
                                     Width="18">
                                <Path Data="{DynamicResource NetworkOutlineIcon}" />
                            </Viewbox>
                            <TextBlock Text="{extensions:Localization Overview}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Classes="navigation-header"
                                 IsEnabled="False">
                        <TextBlock Margin="20,28,20,4"
                                   Text="{extensions:Localization Settings,
                                                                  ToUpper=True}" />
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static types:NavigationPageType.App}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">
                            <Viewbox Height="18"
                                     VerticalAlignment="Center"
                                     Width="18">
                                <Path Data="{DynamicResource SettingsOutlineIcon}" />
                            </Viewbox>
                            <TextBlock Text="{extensions:Localization App}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Classes="navigation-header"
                                 IsEnabled="False">
                        <TextBlock Margin="20,28,20,4"
                                   Text="{extensions:Localization Info,
                                                                  ToUpper=True}" />
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static types:NavigationPageType.About}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">
                            <Viewbox Height="18"
                                     VerticalAlignment="Center"
                                     Width="18">
                                <Path Data="{DynamicResource InfoOutlineIcon}" />
                            </Viewbox>
                            <TextBlock Text="{extensions:Localization About}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static types:NavigationPageType.Licenses}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">
                            <Viewbox Height="18"
                                     VerticalAlignment="Center"
                                     Width="18">
                                <Path Data="{DynamicResource CopyrightOutlineIcon}" />
                            </Viewbox>
                            <TextBlock Text="{extensions:Localization Licenses}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                </ListBox>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="{OnPlatform Default=1,
                                             macOS=0}"
                    Grid.ColumnSpan="{OnPlatform Default=1,
                                                 macOS=2}"
                    Background="Transparent"
                    Height="33"
                    WindowDecorationProperties.ElementRole="TitleBar"
                    IsVisible="{OnPlatform Default=True,
                                           Linux=False}" />

            <ContentControl Grid.Row="1"
                            Grid.Column="1"
                            Background="{DynamicResource AppBackgroundAltBrush}"
                            Content="{Binding CurrentPage}" />

        </Grid>
        <Border Background="{DynamicResource OverlayBrush}"
                IsVisible="{Binding IsDialogOpen}" />
    </Panel>
</Window>
