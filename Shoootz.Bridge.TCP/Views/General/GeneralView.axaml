<UserControl x:Class="Shoootz.Bridge.TCP.Views.General.GeneralView"
             xmlns="https://github.com/avaloniaui"
             xmlns:extensions="using:Shoootz.Common.Extensions"
             xmlns:vm="using:Shoootz.Bridge.TCP.ViewModels.General"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:GeneralViewModel">

    <StackPanel Classes="page-content">

        <TextBlock Classes="h3"
                   Text="{extensions:Localization Overview}" />

        <TextBlock HorizontalAlignment="Right"
                   Margin="0,0,10,0"
                   Text="{Binding LocalIpAddress}" />

        <Border Classes="card"
                Padding="24">
            <StackPanel Spacing="{DynamicResource SpacingMedium}">

                <TextBlock Classes="h4"
                           Text="{extensions:Localization Status}" />

                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="{DynamicResource SpacingMedium}">
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{extensions:Localization Connection}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="{extensions:Localization Running}"
                               IsVisible="{Binding Bridge.IsRunning}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{extensions:Localization Stopped}"
                               IsVisible="{Binding !Bridge.IsRunning}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{extensions:Localization ConnectedClients}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               Text="{Binding Bridge.ConnectedClientCount}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="{extensions:Localization RelayedPackets}" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               Text="{Binding Bridge.PacketsRelayedCount}" />
                </Grid>
            </StackPanel>
        </Border>

        <Button Classes="danger"
                Command="{Binding StopCommand}"
                Content="{extensions:Localization Stop}"
                HorizontalAlignment="Right"
                IsVisible="{Binding Bridge.IsRunning}" />
        <Button Classes="blue"
                Command="{Binding StartCommand}"
                Content="{extensions:Localization Start}"
                HorizontalAlignment="Right"
                IsEnabled="{Binding Bridge.IsStartEnabled}"
                IsVisible="{Binding !Bridge.IsRunning}" />
    </StackPanel>
</UserControl>
