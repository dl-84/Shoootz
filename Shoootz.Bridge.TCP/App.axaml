<Application x:Class="Shoootz.Bridge.TCP.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:common="using:Shoootz.Common.Views"
             xmlns:icons="using:Controls.Icons"
             xmlns:themes="using:Themes.Lagoon"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <common:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <themes:Lagoon />
        <icons:Icons />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Clicked="OnTrayIconClicked"
                      Icon="/Assets/Logo.png"
                      ToolTipText="Shoootz TCP Bridge">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Click="OnTrayShowClicked" />
                        <NativeMenuItem Click="OnTrayExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
