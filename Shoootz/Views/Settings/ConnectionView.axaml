<UserControl x:Class="Shoootz.Views.Settings.ConnectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:extensions="clr-namespace:Shoootz.Views.Extensions"
             xmlns:loc="using:Shoootz.Extensions"
             xmlns:models="using:Shoootz.Models.Settings.Language"
             xmlns:services="clr-namespace:Shoootz.Views.Services"
             xmlns:vm="using:Shoootz.ViewModels.Settings"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:ConnectionViewModel">

    <Panel>

        <ScrollViewer>
            <StackPanel Classes="page-content">

                <TextBlock Classes="h3"
                           Text="{extensions:Localization App}" />

                <StackPanel HorizontalAlignment="Right"
                            Margin="0,0,10,0"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource SpacingMedium}">
                    <PathIcon Classes="icon-action"
                              Data="{DynamicResource SaveIcon}"
                              PointerPressed="OnCommandIconPressed"
                              Tag="{Binding SaveCommand}"
                              ToolTip.HorizontalOffset="0"
                              ToolTip.Placement="TopEdgeAlignedRight"
                              ToolTip.Tip="{extensions:Localization Save}"
                              ToolTip.VerticalOffset="-2"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding IsSaveEnabled}" />
                </StackPanel>

                <Border Classes="card">
                    <StackPanel Spacing="{DynamicResource SpacingMedium}">

                        <TextBlock Classes="h4"
                                   Text="{extensions:Localization General}" />

                        <Grid ColumnDefinitions="Auto,*">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguageOption}"
                                      Width="170">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:LanguageOptionModel">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{DynamicResource SpacingSmall}"
                                                    VerticalAlignment="Center">
                                            <Image AutomationProperties.AccessibilityView="Raw"
                                                   Height="24"
                                                   Source="{Binding Flag}"
                                                   VerticalAlignment="Center"
                                                   Width="40" />
                                            <TextBlock Text="{Binding CultureInfo.NativeName}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingMedium}">
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource FolderOpenIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding OpenSettingsFolderCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization OpenFolder}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center" />
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource FileLinesIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding ShowSettingsContentCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization ShowSettings}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center" />
                                <PathIcon Classes="icon-action icon-danger"
                                          Data="{DynamicResource FileCircleXmarkIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding DeleteSettingsFileCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization DeleteSettingsFile}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center" />
                                <PathIcon Classes="icon-action icon-danger"
                                          Data="{DynamicResource DeleteIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding DeleteSettingsFolderCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization DeleteAll}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="{DynamicResource SpacingMedium}">

                        <TextBlock Classes="h4"
                                   Text="{extensions:Localization UdpBroadcast}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingSmall}">
                                <PathIcon Data="{DynamicResource DatabaseDisconnectedIcon}"
                                          Foreground="{DynamicResource ErrorBrush}"
                                          Height="18"
                                          VerticalAlignment="Center"
                                          Width="18"
                                          IsVisible="{Binding !IsUdpListening}" />
                                <PathIcon Data="{DynamicResource DatabaseConnectedIcon}"
                                          Foreground="{DynamicResource SuccessBrush}"
                                          Height="18"
                                          VerticalAlignment="Center"
                                          Width="18"
                                          IsVisible="{Binding IsUdpListening}" />
                                <TextBlock Text="{Binding UdpStatusLabel}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingMedium}">
                                <PathIcon Classes="icon-action icon-danger"
                                          Data="{DynamicResource DatabaseDisconnectIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding StopUdpCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization Stop}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding IsUdpListening}" />
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource DatabaseConnectIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding StartUdpCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization Start}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding IsPortValid}"
                                          IsVisible="{Binding !IsUdpListening}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="170,*"
                              ColumnSpacing="{DynamicResource SpacingSmall}">

                            <StackPanel Grid.Column="0"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{extensions:Localization Port}" />
                                <TextBox AutomationProperties.HelpText="{extensions:Localization PortRangeHint}"
                                         Classes.error="{Binding !IsPortValid}"
                                         MaxLength="5"
                                         Text="{Binding Port}"
                                         services:InputFilter.AllowedPattern="[0-9]"
                                         IsEnabled="{Binding !IsUdpListening}" />
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Grid.Row="0"
                                           Classes="label"
                                           IsHitTestVisible="False"
                                           Opacity="0"
                                           Text="placeholder" />
                                <CheckBox Grid.Row="1"
                                          Content="{extensions:Localization AutoConnect}"
                                          FontSize="16"
                                          HorizontalAlignment="Right"
                                          IsChecked="{Binding AutoConnect}"
                                          VerticalAlignment="Center" />
                            </Grid>

                        </Grid>

                        <TextBlock Classes="hint-error"
                                   Text="{extensions:Localization PortRangeHint}"
                                   IsVisible="{Binding !IsPortValid}" />

                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="{DynamicResource SpacingMedium}">

                        <TextBlock Classes="h4"
                                   Text="{extensions:Localization Database}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingSmall}">
                                <PathIcon Data="{DynamicResource DatabaseDisconnectedIcon}"
                                          Foreground="{DynamicResource ErrorBrush}"
                                          Height="18"
                                          VerticalAlignment="Center"
                                          Width="18"
                                          IsVisible="{Binding !IsDbConnected}" />
                                <PathIcon Data="{DynamicResource DatabaseConnectedIcon}"
                                          Foreground="{DynamicResource SuccessBrush}"
                                          Height="18"
                                          VerticalAlignment="Center"
                                          Width="18"
                                          IsVisible="{Binding IsDbConnected}" />
                                <TextBlock Text="{Binding InitializeDbLabel}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingMedium}">
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource AddIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding CreateDbCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization CreateDb}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding !IsSaveEnabled}"
                                          IsVisible="{Binding !IsDbConnected}" />
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource HeartPulseIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding TestDbConnectionCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization TestConnection}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center" />
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource InitializeDbIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding InitializeDbCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization InitializeDb}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding IsInitializeDbEnabled}" />
                                <PathIcon Classes="icon-action icon-danger"
                                          Data="{DynamicResource DatabaseDisconnectIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding DisconnectDbCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization Stop}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding IsDbConnected}" />
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource DatabaseConnectIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding ConnectDbCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{extensions:Localization Start}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding !IsSaveEnabled}"
                                          IsVisible="{Binding !IsDbConnected}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="{DynamicResource SpacingSmall}">

                            <StackPanel Grid.Column="0"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{extensions:Localization Provider}" />
                                <ComboBox ItemsSource="{Binding ProviderOptions}"
                                          SelectedItem="{Binding SelectedProvider}"
                                          Width="170"
                                          IsEnabled="{Binding !IsDbConnected}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{extensions:Localization ConnectionString}" />
                                <TextBox Text="{Binding ConnectionString}"
                                         IsEnabled="{Binding !IsDbConnected}" />
                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Panel>
</UserControl>
