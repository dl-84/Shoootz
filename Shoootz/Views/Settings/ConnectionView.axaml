<UserControl x:Class="Shoootz.Views.Settings.ConnectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:cards="using:Shoootz.Common.Views.Settings"
             xmlns:common="using:Shoootz.Common.Extensions"
             xmlns:loc="using:Shoootz.Extensions"
             xmlns:vm="using:Shoootz.ViewModels.Settings"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:ConnectionViewModel">

    <UserControl.Resources>
        <loc:EnumConverter x:Key="ReceiverTypeConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0">
            <StackPanel Classes="page-content">

                <TextBlock Classes="h3"
                           Text="{common:Localization App}" />

                <cards:GeneralSettingsCard DataContext="{Binding GeneralSettings}" />

                <Border Classes="card">
                    <StackPanel Spacing="{DynamicResource SpacingMedium}">

                        <TextBlock Classes="h4"
                                   Text="{common:Localization UdpBroadcast}" />

                        <Grid ColumnDefinitions="170,170,170,*,170"
                              ColumnSpacing="{DynamicResource SpacingSmall}">

                            <StackPanel Grid.Column="0"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization ReceiverType}" />
                                <ComboBox ItemsSource="{Binding ReceiverTypeOptions}"
                                          SelectedItem="{Binding SelectedReceiverType}"
                                          Width="170"
                                          IsEnabled="{Binding !IsUdpListening}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ReceiverTypeConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization Host}" />
                                <TextBox Classes.error="{Binding !IsHostValid}"
                                         Text="{Binding Host}"
                                         IsEnabled="{Binding IsHostEditable}">
                                    <TextBox.InnerRightContent>
                                        <PathIcon Classes="icon-action icon-danger clear-icon"
                                                  Data="{StaticResource CloseIcon}"
                                                  Height="12"
                                                  Margin="0,0,10,0"
                                                  PointerPressed="OnClearHostIconPressed"
                                                  Width="12" />
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization Port}" />
                                <TextBox AutomationProperties.HelpText="{common:Localization PortRangeHint}"
                                         Classes.error="{Binding !IsPortValid}"
                                         MaxLength="5"
                                         Text="{Binding Port}"
                                         common:InputFilter.AllowedPattern="[0-9]"
                                         IsEnabled="{Binding !IsUdpListening}">
                                    <TextBox.InnerRightContent>
                                        <PathIcon Classes="icon-action icon-danger clear-icon"
                                                  Data="{StaticResource CloseIcon}"
                                                  Height="12"
                                                  Margin="0,0,10,0"
                                                  PointerPressed="OnClearPortIconPressed"
                                                  Width="12" />
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>

                            <Grid Grid.Column="3"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Grid.Row="0"
                                           Classes="label"
                                           IsHitTestVisible="False"
                                           Opacity="0"
                                           Text="placeholder" />
                                <CheckBox Grid.Row="1"
                                          Content="{common:Localization AutoConnect}"
                                          FontSize="16"
                                          HorizontalAlignment="Center"
                                          IsChecked="{Binding AutoConnect}"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Column="4"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Grid.Row="0"
                                           Classes="label"
                                           IsHitTestVisible="False"
                                           Opacity="0"
                                           Text="placeholder" />
                                <Button Grid.Row="1"
                                        Classes="danger"
                                        Command="{Binding DisconnectReceiverCommand}"
                                        Content="{common:Localization Disconnect}"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding IsUdpListening}" />
                                <Button Grid.Row="1"
                                        Classes="blue"
                                        Command="{Binding ConnectReceiverCommand}"
                                        Content="{common:Localization Connect}"
                                        HorizontalAlignment="Right"
                                        IsEnabled="{Binding IsConnectReceiverEnabled}"
                                        IsVisible="{Binding !IsUdpListening}" />
                            </Grid>

                        </Grid>

                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="{DynamicResource SpacingMedium}">

                        <StackPanel Orientation="Horizontal"
                                    Spacing="{DynamicResource SpacingSmall}">
                            <PathIcon Classes.db-status-not-initialized="{Binding IsDbNotInitialized}"
                                      Classes.db-status-up-to-date="{Binding IsDbUpToDate}"
                                      Classes.db-status-update-available="{Binding IsDbUpdateAvailable}"
                                      Height="18"
                                      PointerPressed="OnDbStatusBadgePressed"
                                      ToolTip.Tip="{Binding InitializeDbLabel}"
                                      VerticalAlignment="Center"
                                      Width="18" />

                            <TextBlock Classes="h4"
                                       Text="{common:Localization Database}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*,170"
                              ColumnSpacing="{DynamicResource SpacingSmall}">

                            <StackPanel Grid.Column="0"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization Provider}" />
                                <ComboBox ItemsSource="{Binding ProviderOptions}"
                                          SelectedItem="{Binding SelectedProvider}"
                                          Width="170"
                                          IsEnabled="{Binding !IsDbConnected}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization ConnectionString}" />
                                <TextBox Text="{Binding ConnectionString}"
                                         IsEnabled="{Binding !IsDbConnected}" />
                            </StackPanel>

                            <Grid Grid.Column="2"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Grid.Row="0"
                                           Classes="label"
                                           IsHitTestVisible="False"
                                           Opacity="0"
                                           Text="placeholder" />
                                <Button Grid.Row="1"
                                        Classes="danger"
                                        Command="{Binding DisconnectDbCommand}"
                                        Content="{common:Localization Disconnect}"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding IsDbConnected}" />
                                <Button Grid.Row="1"
                                        Classes="blue"
                                        Command="{Binding ConnectDbCommand}"
                                        Content="{common:Localization Connect}"
                                        HorizontalAlignment="Right"
                                        IsEnabled="{Binding !IsSaveEnabled}"
                                        IsVisible="{Binding !IsDbConnected}" />
                            </Grid>

                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="18,16,18,18">
            <TextBlock Grid.Column="0"
                       Classes="hint-error"
                       Text="{Binding ConnectionErrorHint}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Classes="blue"
                    Command="{Binding SaveCommand}"
                    Content="{common:Localization Save}"
                    HorizontalAlignment="Right"
                    IsEnabled="{Binding IsSaveEnabled}" />
        </Grid>

    </Grid>
</UserControl>
