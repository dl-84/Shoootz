<UserControl x:Class="Shoootz.Views.Settings.ConnectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:cards="using:Shoootz.Common.Views.Settings"
             xmlns:common="using:Shoootz.Common.Extensions"
             xmlns:loc="using:Shoootz.Extensions"
             xmlns:vm="using:Shoootz.ViewModels.Settings"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:ConnectionViewModel">

    <UserControl.Resources>
        <loc:EnumConverter x:Key="ReceiverTypeConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBox PathIcon.clear-icon">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TextBox:pointerover PathIcon.clear-icon">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel>

        <ScrollViewer>
            <StackPanel Classes="page-content">

                <TextBlock Classes="h3"
                           Text="{common:Localization App}" />

                <cards:GeneralSettingsCard DataContext="{Binding GeneralSettings}" />

                <Border Classes="card">
                    <StackPanel Spacing="{DynamicResource SpacingMedium}">

                        <TextBlock Classes="h4"
                                   Text="{common:Localization UdpBroadcast}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingSmall}">
                                <PathIcon Data="{DynamicResource DatabaseDisconnectedIcon}"
                                          Foreground="{DynamicResource ErrorBrush}"
                                          Height="18"
                                          VerticalAlignment="Center"
                                          Width="18"
                                          IsVisible="{Binding !IsUdpListening}" />
                                <PathIcon Data="{DynamicResource DatabaseConnectedIcon}"
                                          Foreground="{DynamicResource SuccessBrush}"
                                          Height="18"
                                          VerticalAlignment="Center"
                                          Width="18"
                                          IsVisible="{Binding IsUdpListening}" />
                                <TextBlock Text="{Binding UdpStatusLabel}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingMedium}">
                                <PathIcon Classes="icon-action icon-danger"
                                          Data="{DynamicResource DatabaseDisconnectIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding DisconnectReceiverCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{common:Localization Disconnect}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding IsUdpListening}" />
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource DatabaseConnectIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding ConnectReceiverCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{common:Localization Connect}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding IsPortValid}"
                                          IsVisible="{Binding !IsUdpListening}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="170,170,170,*"
                              ColumnSpacing="{DynamicResource SpacingSmall}">

                            <StackPanel Grid.Column="0"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization ReceiverType}" />
                                <ComboBox ItemsSource="{Binding ReceiverTypeOptions}"
                                          SelectedItem="{Binding SelectedReceiverType}"
                                          Width="170"
                                          IsEnabled="{Binding !IsUdpListening}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ReceiverTypeConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization Host}" />
                                <TextBox Classes.error="{Binding !IsHostValid}"
                                         Text="{Binding Host}"
                                         IsEnabled="{Binding IsTcpSelected}">
                                    <TextBox.InnerRightContent>
                                        <PathIcon Classes="icon-action icon-danger clear-icon"
                                                  Data="{StaticResource CloseIcon}"
                                                  Height="12"
                                                  Margin="0,0,10,0"
                                                  PointerPressed="OnClearHostIconPressed"
                                                  Width="12" />
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization Port}" />
                                <TextBox AutomationProperties.HelpText="{common:Localization PortRangeHint}"
                                         Classes.error="{Binding !IsPortValid}"
                                         MaxLength="5"
                                         Text="{Binding Port}"
                                         common:InputFilter.AllowedPattern="[0-9]"
                                         IsEnabled="{Binding !IsUdpListening}">
                                    <TextBox.InnerRightContent>
                                        <PathIcon Classes="icon-action icon-danger clear-icon"
                                                  Data="{StaticResource CloseIcon}"
                                                  Height="12"
                                                  Margin="0,0,10,0"
                                                  PointerPressed="OnClearPortIconPressed"
                                                  Width="12" />
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>

                            <Grid Grid.Column="3"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Grid.Row="0"
                                           Classes="label"
                                           IsHitTestVisible="False"
                                           Opacity="0"
                                           Text="placeholder" />
                                <CheckBox Grid.Row="1"
                                          Content="{common:Localization AutoConnect}"
                                          FontSize="16"
                                          HorizontalAlignment="Right"
                                          IsChecked="{Binding AutoConnect}"
                                          VerticalAlignment="Center" />
                            </Grid>

                        </Grid>

                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="{DynamicResource SpacingMedium}">

                        <TextBlock Classes="h4"
                                   Text="{common:Localization Database}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingSmall}">
                                <PathIcon Data="{DynamicResource DatabaseDisconnectedIcon}"
                                          Foreground="{DynamicResource ErrorBrush}"
                                          Height="18"
                                          VerticalAlignment="Center"
                                          Width="18"
                                          IsVisible="{Binding !IsDbConnected}" />
                                <PathIcon Data="{DynamicResource DatabaseConnectedIcon}"
                                          Foreground="{DynamicResource SuccessBrush}"
                                          Height="18"
                                          VerticalAlignment="Center"
                                          Width="18"
                                          IsVisible="{Binding IsDbConnected}" />
                                <TextBlock Text="{Binding InitializeDbLabel}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingMedium}">
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource AddIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding CreateDbCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{common:Localization CreateDb}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding !IsSaveEnabled}"
                                          IsVisible="{Binding !IsDbConnected}" />
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource HeartPulseIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding TestDbConnectionCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{common:Localization TestConnection}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center" />
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource InitializeDbIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding InitializeDbCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{common:Localization InitializeDb}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding IsInitializeDbEnabled}" />
                                <PathIcon Classes="icon-action icon-danger"
                                          Data="{DynamicResource DatabaseDisconnectIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding DisconnectDbCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{common:Localization Disconnect}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding IsDbConnected}" />
                                <PathIcon Classes="icon-action"
                                          Data="{DynamicResource DatabaseConnectIcon}"
                                          PointerPressed="OnCommandIconPressed"
                                          Tag="{Binding ConnectDbCommand}"
                                          ToolTip.HorizontalOffset="0"
                                          ToolTip.Placement="TopEdgeAlignedRight"
                                          ToolTip.Tip="{common:Localization Connect}"
                                          ToolTip.VerticalOffset="-2"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding !IsSaveEnabled}"
                                          IsVisible="{Binding !IsDbConnected}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="{DynamicResource SpacingSmall}">

                            <StackPanel Grid.Column="0"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization Provider}" />
                                <ComboBox ItemsSource="{Binding ProviderOptions}"
                                          SelectedItem="{Binding SelectedProvider}"
                                          Width="170"
                                          IsEnabled="{Binding !IsDbConnected}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="{DynamicResource SpacingXSmall}">
                                <TextBlock Classes="label"
                                           Text="{common:Localization ConnectionString}" />
                                <TextBox Text="{Binding ConnectionString}"
                                         IsEnabled="{Binding !IsDbConnected}" />
                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="hint-error"
                               Text="{Binding ConnectionErrorHint}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Classes="blue"
                            Command="{Binding SaveCommand}"
                            Content="{common:Localization Save}"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding IsSaveEnabled}" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

    </Panel>
</UserControl>
