
<UserControl x:Class="Shoootz.Views.Info.LicensesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:common="using:Shoootz.Common.Extensions"
             xmlns:controls="using:Controls.LicenseTable"
             xmlns:vm="using:Shoootz.ViewModels.Info"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:LicensesViewModel">

    <Grid Margin="18,0,18,18"
          RowDefinitions="Auto,*">

        <TextBlock Classes="h3"
                   Margin="0,0,0,16"
                   Text="{common:Localization LicensesTitle}" />

        <controls:LicenseTableControl Grid.Row="1"
                                      Headers="{Binding ColumnHeaders}"
                                      Items="{Binding Packages}" />

    </Grid>

</UserControl>
