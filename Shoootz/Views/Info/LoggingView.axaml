<UserControl x:Class="Shoootz.Views.Info.LoggingView"
             xmlns="https://github.com/avaloniaui"
             xmlns:common="using:Shoootz.Common.Extensions"
             xmlns:sc="using:Controls.CounterCard"
             xmlns:vm="using:Shoootz.ViewModels.Info"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:LoggingViewModel">

    <Grid Margin="18,0,18,18"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="{DynamicResource SpacingMedium}">

        <TextBlock Grid.Row="0"
                   Classes="h3"
                   Text="{common:Localization Logging}" />

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="{DynamicResource SpacingMedium}"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="{DynamicResource SpacingMedium}">

            <sc:CounterCardControl Grid.Row="0"
                                   Grid.Column="0"
                                   InfoText="{common:Localization ShotCounterReceivedTooltip}"
                                   Label="{common:Localization ShotCounterReceived}"
                                   Value="{Binding ReceivedShots}" />

            <sc:CounterCardControl Grid.Row="0"
                                   Grid.Column="1"
                                   InfoText="{common:Localization ShotCounterParsedTooltip}"
                                   Label="{common:Localization ShotCounterParsed}"
                                   Value="{Binding ParsedShots}" />

            <sc:CounterCardControl Grid.Row="0"
                                   Grid.Column="2"
                                   InfoText="{common:Localization ShotCounterSavedTooltip}"
                                   Label="{common:Localization ShotCounterSaved}"
                                   Value="{Binding SavedShots}" />

            <sc:CounterCardControl Grid.Row="1"
                                   Grid.Column="0"
                                   InfoText="{common:Localization ShotCounterWarmupTooltip}"
                                   Label="{common:Localization ShotCounterWarmup}"
                                   Value="{Binding WarmupShots}" />

            <sc:CounterCardControl Grid.Row="1"
                                   Grid.Column="1"
                                   InfoText="{common:Localization ShotCounterIncorrectNumberOfObjectsTooltip}"
                                   IsDanger="True"
                                   Label="{common:Localization ShotCounterIncorrectNumberOfObjects}"
                                   Value="{Binding IncorrectNumberOfObjects}" />

            <sc:CounterCardControl Grid.Row="1"
                                   Grid.Column="2"
                                   InfoText="{common:Localization ShotCounterNotTypeOfShotTooltip}"
                                   IsDanger="True"
                                   Label="{common:Localization ShotCounterNotTypeOfShot}"
                                   Value="{Binding NotTypeOfShot}" />

            <sc:CounterCardControl Grid.Row="2"
                                   Grid.Column="0"
                                   InfoText="{common:Localization ShotCounterMissingShooterDataTooltip}"
                                   IsDanger="True"
                                   Label="{common:Localization ShotCounterMissingShooterData}"
                                   Value="{Binding MissingShooterData}" />

            <sc:CounterCardControl Grid.Row="2"
                                   Grid.Column="1"
                                   InfoText="{common:Localization ShotCounterParsedErrorTooltip}"
                                   IsDanger="True"
                                   Label="{common:Localization ShotCounterParsedError}"
                                   Value="{Binding ParsedShotErrors}" />

            <sc:CounterCardControl Grid.Row="2"
                                   Grid.Column="2"
                                   InfoText="{common:Localization ShotCounterSavedErrorTooltip}"
                                   IsDanger="True"
                                   Label="{common:Localization ShotCounterSavedError}"
                                   Value="{Binding SavedShotErrors}" />
        </Grid>

        <Border Grid.Row="2"
                Classes="card">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="{DynamicResource SpacingMedium}">

                <TextBlock Grid.Row="0"
                           Classes="h4"
                           Text="{common:Localization LoggingRawTitle}" />

                <ListBox Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         CornerRadius="0"
                         ItemsSource="{Binding Logs}"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         SelectionChanged="OnLogEntrySelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{DynamicResource SpacingSmall}">
                                <TextBlock FontFamily="{DynamicResource FontMono}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" />
                                <TextBlock FontFamily="{DynamicResource FontMono}"
                                           Text="{Binding RawData}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

    </Grid>
</UserControl>
