<Window x:Class="Shoootz.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="using:Shoootz.Extensions"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="using:Controls.TitleBar"
        xmlns:vm="using:Shoootz.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:DataType="vm:MainWindowViewModel"
        Background="Transparent"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="True"
        Height="768"
        Icon="/Assets/Disag/Logo.png"
        MinHeight="768"
        MinWidth="1366"
        Title="Shoootz"
        TransparencyLevelHint="Transparent"
        Width="1366"
        WindowDecorations="BorderOnly"
        d:DesignHeight="768"
        d:DesignWidth="1366"
        mc:Ignorable="d">

    <Border x:Name="RootBorder"
            ClipToBounds="True"
            CornerRadius="10">
        <Panel>
            <DockPanel>

                <tb:TitleBarControl />

                <Grid ColumnDefinitions="220,*">

                    <Border Grid.Column="0"
                            Background="{DynamicResource PrimaryBrush}">
                        <DockPanel>
                            <Grid ColumnDefinitions="*,Auto,*,Auto,*"
                                  DockPanel.Dock="Bottom"
                                  Margin="0,16,0,20">
                                <PathIcon Grid.Column="1"
                                          Data="{DynamicResource DatabaseIcon}"
                                          Foreground="{Binding DatabaseStatusBrush}"
                                          Height="24"
                                          ToolTip.Tip="{Binding DbBadgeText}"
                                          Width="24" />
                                <PathIcon Grid.Column="3"
                                          Data="{DynamicResource NetworkWiredIcon}"
                                          Foreground="{Binding NetworkWiredStatusBrush}"
                                          Height="24"
                                          ToolTip.Tip="{Binding UdpBadgeText}"
                                          Width="24" />
                            </Grid>
                            <ListBox x:Name="NavList"
                                     Classes="nav"
                                     ItemContainerTheme="{DynamicResource NavigationItem}"
                                     Margin="{DynamicResource MarginTopMedium}"
                                     SelectionChanged="OnNavSelectionChanged"
                                     IsEnabled="{Binding IsNavbarEnabled}">

                                <ListBoxItem Classes="navigation-header"
                                             IsEnabled="False">
                                    <TextBlock Margin="20,16,20,4"
                                               Text="{loc:Localization Competition,
                                                                       ToUpper=True}" />
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static vm:NavigationPageType.Evaluate}">
                                    <TextBlock Text="{loc:Localization Evaluate}" />
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static vm:NavigationPageType.Shooters}">
                                    <TextBlock Text="{loc:Localization Shooters}" />
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static vm:NavigationPageType.Clubs}">
                                    <TextBlock Text="{loc:Localization Clubs}" />
                                </ListBoxItem>

                                <ListBoxItem Classes="navigation-header"
                                             IsEnabled="False">
                                    <TextBlock Margin="20,28,20,4"
                                               Text="{loc:Localization Settings,
                                                                       ToUpper=True}" />
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static vm:NavigationPageType.App}">
                                    <TextBlock Text="{loc:Localization App}" />
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static vm:NavigationPageType.Groups}">
                                    <TextBlock Text="{loc:Localization Groups}" />
                                </ListBoxItem>

                                <ListBoxItem Classes="navigation-header"
                                             IsEnabled="False">
                                    <TextBlock Margin="20,28,20,4"
                                               Text="{loc:Localization Info,
                                                                       ToUpper=True}" />
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static vm:NavigationPageType.About}">
                                    <TextBlock Text="{loc:Localization About}" />
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static vm:NavigationPageType.Licenses}">
                                    <TextBlock Text="{loc:Localization Licenses}" />
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static vm:NavigationPageType.Logging}">
                                    <TextBlock Text="{loc:Localization Logging}" />
                                </ListBoxItem>

                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ContentControl Grid.Column="1"
                                    Background="{DynamicResource AppBackgroundAltBrush}"
                                    Content="{Binding CurrentPage}" />

                </Grid>
            </DockPanel>
            <Border Background="{DynamicResource OverlayBrush}"
                    IsVisible="{Binding IsDialogOpen}" />
        </Panel>
    </Border>
</Window>
