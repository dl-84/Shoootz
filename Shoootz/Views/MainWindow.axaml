<Window x:Class="Shoootz.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:common="using:Shoootz.Common.Extensions"
        xmlns:controls="clr-namespace:Controls.TitleBar.Controls;assembly=TitleBar"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="using:Controls.TitleBar"
        xmlns:types="clr-namespace:Shoootz.Views.Types"
        xmlns:vm="using:Shoootz.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:DataType="vm:MainWindowViewModel"
        Background="Transparent"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="True"
        Height="768"
        Icon="/Assets/Logo/Logo.png"
        MinHeight="768"
        MinWidth="1366"
        Title="Shoootz"
        TransparencyLevelHint="Transparent"
        Width="1366"
        WindowDecorations="BorderOnly"
        d:DesignHeight="768"
        d:DesignWidth="1366"
        mc:Ignorable="d">

    <Border x:Name="RootBorder"
            ClipToBounds="True"
            CornerRadius="10">
        <Panel>
            <Grid ColumnDefinitions="220,*"
                  RowDefinitions="36,*">

                <Border x:Name="NavBorder"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.RowSpan="2"
                        Background="{DynamicResource PrimaryBrush}">
                    <DockPanel>
                        <Grid ColumnDefinitions="*,Auto,*,Auto,*"
                              DockPanel.Dock="Bottom"
                              Margin="0,16,0,20">
                            <PathIcon Grid.Column="1"
                                      Classes.status-error="{Binding !IsDbConnected}"
                                      Classes.status-success="{Binding IsDbConnected}"
                                      Data="{DynamicResource DatabaseIcon}"
                                      Height="24"
                                      ToolTip.Tip="{Binding DbBadgeText}"
                                      Width="24" />
                            <PathIcon Grid.Column="3"
                                      Classes.status-error="{Binding !IsUdpConnected}"
                                      Classes.status-success="{Binding IsUdpConnected}"
                                      Data="{DynamicResource NetworkWiredIcon}"
                                      Height="24"
                                      ToolTip.Tip="{Binding UdpBadgeText}"
                                      Width="24" />
                        </Grid>
                        <ListBox x:Name="NavList"
                                 Classes="nav"
                                 ItemContainerTheme="{DynamicResource NavigationItem}"
                                 Margin="{DynamicResource MarginTopMedium}"
                                 SelectionChanged="OnNavSelectionChanged"
                                 IsEnabled="{Binding IsNavbarEnabled}">

                            <ListBoxItem Classes="navigation-header"
                                         IsEnabled="False">
                                <TextBlock Margin="20,16,20,4"
                                           Text="{common:Localization Competition,
                                                                      ToUpper=True}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static types:NavigationPageType.Evaluate}">
                                <TextBlock Text="{common:Localization Evaluate}" />
                            </ListBoxItem>

                            <ListBoxItem Classes="navigation-header"
                                         IsEnabled="False">
                                <TextBlock Margin="20,28,20,4"
                                           Text="{common:Localization Data,
                                                                      ToUpper=True}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static types:NavigationPageType.Shots}">
                                <TextBlock Text="{common:Localization Shots}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static types:NavigationPageType.Shooters}">
                                <TextBlock Text="{common:Localization Shooters}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static types:NavigationPageType.Clubs}">
                                <TextBlock Text="{common:Localization Clubs}" />
                            </ListBoxItem>

                            <ListBoxItem Classes="navigation-header"
                                         IsEnabled="False">
                                <TextBlock Margin="20,28,20,4"
                                           Text="{common:Localization Settings,
                                                                      ToUpper=True}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static types:NavigationPageType.App}">
                                <TextBlock Text="{common:Localization App}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static types:NavigationPageType.Groups}">
                                <TextBlock Text="{common:Localization Groups}" />
                            </ListBoxItem>

                            <ListBoxItem Classes="navigation-header"
                                         IsEnabled="False">
                                <TextBlock Margin="20,28,20,4"
                                           Text="{common:Localization Info,
                                                                      ToUpper=True}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static types:NavigationPageType.About}">
                                <TextBlock Text="{common:Localization About}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static types:NavigationPageType.Licenses}">
                                <TextBlock Text="{common:Localization Licenses}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static types:NavigationPageType.Logging}">
                                <TextBlock Text="{common:Localization Logging}" />
                            </ListBoxItem>

                        </ListBox>
                    </DockPanel>
                </Border>

                <controls:MacTrafficLightsControl Grid.Row="0"
                                                  Grid.Column="0" />

                <tb:TitleBarControl Grid.Row="0"
                                    Grid.Column="1" />

                <ContentControl Grid.Row="1"
                                Grid.Column="1"
                                Background="{DynamicResource AppBackgroundAltBrush}"
                                Content="{Binding CurrentPage}" />

            </Grid>
            <Border Background="{DynamicResource OverlayBrush}"
                    IsVisible="{Binding IsDialogOpen}" />
        </Panel>
    </Border>
</Window>
