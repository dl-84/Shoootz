<Window x:Class="Shoootz.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:common="using:Shoootz.Common.Extensions"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:types="clr-namespace:Shoootz.Views.Types"
        xmlns:vm="using:Shoootz.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:DataType="vm:MainWindowViewModel"
        ExtendClientAreaToDecorationsHint="{OnPlatform Default=True,
                                                       Linux=False}"
        Height="768"
        Icon="/Assets/Logo/Logo.png"
        MinHeight="768"
        MinWidth="1366"
        Title="Shoootz"
        Width="1366"
        WindowDecorations="Full"
        d:DesignHeight="768"
        d:DesignWidth="1366"
        mc:Ignorable="d">

    <Panel>
        <Grid Background="{DynamicResource AppBackgroundAltBrush}"
              ColumnDefinitions="220,*"
              RowDefinitions="Auto,*">

            <Border x:Name="NavBorder"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    Background="{DynamicResource NavigationBackgroundBrush}"
                    Padding="{OnPlatform Default=0,
                                         macOS='0,33,0,0'}">
                <DockPanel>
                    <StackPanel Classes="navigation-status-list"
                                DockPanel.Dock="Bottom">
                        <Border Classes="navigation-divider" />
                        <Grid Classes="navigation-status"
                              ColumnDefinitions="*,Auto"
                              ToolTip.Tip="{Binding DbBadgeText}">
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="navigation-status-label"
                                           Text="{common:Localization Database}" />
                                <TextBlock Classes="navigation-status-detail"
                                           Text="{Binding DbProviderText}" />
                            </StackPanel>
                            <Ellipse Grid.Column="1"
                                     Classes="navigation-status-dot"
                                     Classes.disconnected="{Binding !IsDbConnected}" />
                        </Grid>
                        <Grid Classes="navigation-status"
                              ColumnDefinitions="*,Auto"
                              ToolTip.Tip="{Binding ReceiverBadgeText}">
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="navigation-status-label"
                                           Text="{Binding ReceiverTypeText}" />
                                <TextBlock Classes="navigation-status-detail"
                                           Text="{Binding ReceiverDetailText}" />
                            </StackPanel>
                            <Ellipse Grid.Column="1"
                                     Classes="navigation-status-dot"
                                     Classes.disconnected="{Binding !IsReceiverConnected}" />
                        </Grid>
                    </StackPanel>
                    <ListBox x:Name="NavList"
                             Classes="nav"
                             ItemContainerTheme="{DynamicResource NavigationItem}"
                             Margin="{DynamicResource MarginTopMedium}"
                             SelectionChanged="OnNavSelectionChanged"
                             IsEnabled="{Binding IsNavbarEnabled}">

                        <ListBoxItem Classes="navigation-header"
                                     IsEnabled="False">
                            <TextBlock Margin="20,16,20,4"
                                       Text="{common:Localization Competition,
                                                                  ToUpper=True}" />
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static types:NavigationPageType.Evaluate}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Viewbox Height="18"
                                         VerticalAlignment="Center"
                                         Width="18">
                                    <Path Data="{DynamicResource ChartLineOutlineIcon}" />
                                </Viewbox>
                                <TextBlock Text="{common:Localization Evaluate}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Classes="navigation-header"
                                     IsEnabled="False">
                            <TextBlock Margin="20,28,20,4"
                                       Text="{common:Localization Data,
                                                                  ToUpper=True}" />
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static types:NavigationPageType.Shots}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Viewbox Height="18"
                                         VerticalAlignment="Center"
                                         Width="18">
                                    <Path Data="{DynamicResource TargetOutlineIcon}" />
                                </Viewbox>
                                <TextBlock Text="{common:Localization Shots}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static types:NavigationPageType.Shooters}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Viewbox Height="18"
                                         VerticalAlignment="Center"
                                         Width="18">
                                    <Path Data="{DynamicResource UserOutlineIcon}" />
                                </Viewbox>
                                <TextBlock Text="{common:Localization Shooters}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static types:NavigationPageType.Clubs}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Viewbox Height="18"
                                         VerticalAlignment="Center"
                                         Width="18">
                                    <Path Data="{DynamicResource UsersOutlineIcon}" />
                                </Viewbox>
                                <TextBlock Text="{common:Localization Clubs}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Classes="navigation-header"
                                     IsEnabled="False">
                            <TextBlock Margin="20,28,20,4"
                                       Text="{common:Localization Settings,
                                                                  ToUpper=True}" />
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static types:NavigationPageType.App}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Viewbox Height="18"
                                         VerticalAlignment="Center"
                                         Width="18">
                                    <Path Data="{DynamicResource SettingsOutlineIcon}" />
                                </Viewbox>
                                <TextBlock Text="{common:Localization App}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static types:NavigationPageType.Groups}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Viewbox Height="18"
                                         VerticalAlignment="Center"
                                         Width="18">
                                    <Path Data="{DynamicResource UsersOutlineIcon}" />
                                </Viewbox>
                                <TextBlock Text="{common:Localization Groups}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Classes="navigation-header"
                                     IsEnabled="False">
                            <TextBlock Margin="20,28,20,4"
                                       Text="{common:Localization Info,
                                                                  ToUpper=True}" />
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static types:NavigationPageType.About}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Viewbox Height="18"
                                         VerticalAlignment="Center"
                                         Width="18">
                                    <Path Data="{DynamicResource InfoOutlineIcon}" />
                                </Viewbox>
                                <TextBlock Text="{common:Localization About}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static types:NavigationPageType.Licenses}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Viewbox Height="18"
                                         VerticalAlignment="Center"
                                         Width="18">
                                    <Path Data="{DynamicResource CopyrightOutlineIcon}" />
                                </Viewbox>
                                <TextBlock Text="{common:Localization Licenses}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static types:NavigationPageType.Logging}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Viewbox Height="18"
                                         VerticalAlignment="Center"
                                         Width="18">
                                    <Path Data="{DynamicResource MonitorActivityOutlineIcon}" />
                                </Viewbox>
                                <TextBlock Text="{common:Localization Logging}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="{OnPlatform Default=1,
                                             macOS=0}"
                    Grid.ColumnSpan="{OnPlatform Default=1,
                                                 macOS=2}"
                    Background="Transparent"
                    Height="33"
                    WindowDecorationProperties.ElementRole="TitleBar"
                    IsVisible="{OnPlatform Default=True,
                                           Linux=False}" />

            <ContentControl Grid.Row="1"
                            Grid.Column="1"
                            Background="{DynamicResource AppBackgroundAltBrush}"
                            Content="{Binding CurrentPage}" />

        </Grid>
        <Border Background="{DynamicResource OverlayBrush}"
                IsVisible="{Binding IsDialogOpen}" />
    </Panel>
</Window>
