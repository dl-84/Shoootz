<UserControl x:Class="Shoootz.Views.Competition.ClubsView"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Shoootz.Extensions"
             xmlns:models="using:Shoootz.Models.Club"
             xmlns:vm="using:Shoootz.ViewModels.Competition"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:ClubsViewModel">

    <ScrollViewer>
        <StackPanel Classes="page-content">

            <TextBlock Classes="h3"
                       Text="{loc:Localization Clubs}" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         HorizontalAlignment="Left"
                         PlaceholderText="{loc:Localization Search}"
                         Text="{Binding SearchText}"
                         Width="300">
                    <TextBox.InnerRightContent>
                        <PathIcon Classes="icon-action icon-danger"
                                  Data="M55.1 73.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L147.2 256 9.9 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192.5 301.3 329.9 438.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.8 256 375.1 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192.5 210.7 55.1 73.4z"
                                  Height="12"
                                  Margin="0,0,10,0"
                                  PointerPressed="OnClearSearchIconPressed"
                                  Width="12"
                                  IsVisible="{Binding HasSearchText}" />
                    </TextBox.InnerRightContent>
                </TextBox>

                <StackPanel Grid.Column="1"
                            Margin="0,0,10,0"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource SpacingMedium}"
                            VerticalAlignment="Center">
                    <PathIcon Classes="icon-action"
                              Data="{DynamicResource AddIcon}"
                              PointerPressed="OnAddIconPressed"
                              VerticalAlignment="Center" />
                    <PathIcon Classes="icon-action"
                              Data="{DynamicResource EditIcon}"
                              PointerPressed="OnEditIconPressed"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding IsClubSelected}" />
                    <PathIcon Classes="icon-action icon-danger"
                              Data="{DynamicResource DeleteIcon}"
                              PointerPressed="OnDeleteIconPressed"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding IsClubSelected}" />
                </StackPanel>
            </Grid>

            <Border Classes="card"
                    Padding="0">
                <StackPanel>
                    <Border Background="{DynamicResource PrimaryBrush}"
                            Padding="24,10">
                        <Grid ColumnDefinitions="*,100">
                            <TextBlock Grid.Column="0"
                                       Classes="table-column-header"
                                       Text="{loc:Localization Name}" />
                            <TextBlock Grid.Column="1"
                                       Classes="table-column-header"
                                       Text="{loc:Localization Shooters}"
                                       TextAlignment="Center" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="ClubsListBox"
                             Classes="table-rows"
                             DoubleTapped="OnClubRowDoubleTapped"
                             ItemsSource="{Binding Clubs}"
                             Margin="0"
                             SelectedItem="{Binding SelectedClub}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ClubModel">
                                <Grid ColumnDefinitions="*,100"
                                      Height="40"
                                      Margin="24,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ShooterCount}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
