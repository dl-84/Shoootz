<UserControl x:Class="Shoootz.Views.Competition.ClubsView"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:extensions="clr-namespace:Shoootz.Views.Extensions"
             xmlns:loc="using:Shoootz.Extensions"
             xmlns:models="using:Shoootz.Models.Club"
             xmlns:sab="using:Controls.SiteActionBar"
             xmlns:services="clr-namespace:Shoootz.Views.Services"
             xmlns:vm="using:Shoootz.ViewModels.Competition"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:ClubsViewModel">

    <ScrollViewer>
        <StackPanel Classes="page-content">

            <TextBlock Classes="h3"
                       Text="{extensions:Localization Clubs}" />

            <sab:SiteActionBarControl AddRequested="OnAddIconPressed"
                                      DeleteRequested="OnDeleteIconPressed"
                                      EditRequested="OnEditIconPressed"
                                      IsActionEnabled="{Binding IsClubSelected}"
                                      SearchPlaceholder="{extensions:Localization Search}"
                                      SearchText="{Binding SearchText}" />

            <Border Classes="card"
                    Padding="0">
                <StackPanel>
                    <Border Background="{DynamicResource PrimaryBrush}"
                            Padding="24,10">
                        <Grid ColumnDefinitions="*,100">
                            <TextBlock Grid.Column="0"
                                       Classes="table-column-header"
                                       Text="{extensions:Localization Name}" />
                            <TextBlock Grid.Column="1"
                                       Classes="table-column-header"
                                       Text="{extensions:Localization Shooters}"
                                       TextAlignment="Center" />
                        </Grid>
                    </Border>
                    <ListBox Classes="table-rows"
                             DoubleTapped="OnClubRowDoubleTapped"
                             ItemsSource="{Binding Clubs}"
                             Margin="0"
                             SelectedItem="{Binding SelectedClub}"
                             services:ListBoxSelectService.DeselectOnClick="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ClubModel">
                                <Grid ColumnDefinitions="*,100"
                                      Height="40"
                                      Margin="24,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ShooterCount}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
