<UserControl x:Class="Shoootz.Views.Competition.ShooterEditView"
             xmlns="https://github.com/avaloniaui"
             xmlns:ff="using:Controls.FormField"
             xmlns:loc="using:Shoootz.Extensions"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12"
                Width="720">
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <Grid Grid.Column="0"
                  ColumnDefinitions="*,*,*">
                <RadioButton x:Name="MaleRadioButton"
                             Grid.Column="0"
                             Content="{loc:Localization GenderMale}"
                             GroupName="Gender" />
                <RadioButton x:Name="FemaleRadioButton"
                             Grid.Column="1"
                             Content="{loc:Localization GenderFemale}"
                             GroupName="Gender" />
                <RadioButton x:Name="DiverseRadioButton"
                             Grid.Column="2"
                             Content="{loc:Localization GenderDiverse}"
                             GroupName="Gender" />
            </Grid>
        </Grid>

        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <ff:FormFieldControl x:Name="LastnameField"
                                 Grid.Column="0"
                                 Label="{loc:Localization Lastname}"
                                 MaxLength="100" />

            <ff:FormFieldControl x:Name="FirstnameField"
                                 Grid.Column="1"
                                 Label="{loc:Localization Firstname}"
                                 MaxLength="100" />
        </Grid>

        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <ff:FormFieldControl x:Name="BirthyearField"
                                 Grid.Column="0"
                                 AllowedPattern="[0-9]"
                                 Label="{loc:Localization Birthyear}"
                                 MaxLength="4" />

            <StackPanel Grid.Column="1"
                        Spacing="4">
                <TextBlock Classes="label"
                           Text="{loc:Localization Club}" />
                <ComboBox x:Name="ClubComboBox"
                          HorizontalAlignment="Stretch"
                          Width="NaN" />
                <TextBlock x:Name="ClubErrorText"
                           Classes="hint-error"
                           IsVisible="False" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
