<UserControl x:Class="Shoootz.Views.Competition.ShootersView"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:extensions="clr-namespace:Shoootz.Views.Extensions"
             xmlns:loc="using:Shoootz.Extensions"
             xmlns:models="using:Shoootz.Models.Shooter"
             xmlns:sab="using:Controls.SiteActionBar"
             xmlns:services="clr-namespace:Shoootz.Views.Services"
             xmlns:vm="using:Shoootz.ViewModels.Competition"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:ShootersViewModel">

    <UserControl.Resources>
        <loc:EnumConverter x:Key="GenderTypeConverter" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Classes="page-content">

            <TextBlock Classes="h3"
                       Text="{extensions:Localization Shooters}" />

            <sab:SiteActionBarControl AddRequested="OnAddIconPressed"
                                      DeleteRequested="OnDeleteIconPressed"
                                      EditRequested="OnEditIconPressed"
                                      IsActionEnabled="{Binding IsShooterSelected}"
                                      SearchPlaceholder="{extensions:Localization Search}"
                                      SearchText="{Binding SearchText}" />

            <Border Classes="card"
                    Padding="0">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <Border Background="{DynamicResource PrimaryBrush}"
                            Padding="24,10">
                        <Grid ColumnSpacing="{DynamicResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition SharedSizeGroup="Birthyear"
                                                  Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition SharedSizeGroup="Gender"
                                                  Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Classes="table-column-header"
                                       Text="{extensions:Localization Lastname}" />
                            <TextBlock Grid.Column="1"
                                       Classes="table-column-header"
                                       Text="{extensions:Localization Firstname}" />
                            <TextBlock Grid.Column="2"
                                       Classes="table-column-header"
                                       Text="{extensions:Localization Club}" />
                            <TextBlock Grid.Column="3"
                                       Classes="table-column-header"
                                       Text="{extensions:Localization Birthyear}"
                                       TextAlignment="Center" />
                            <TextBlock Grid.Column="5"
                                       Classes="table-column-header"
                                       Text="{extensions:Localization Gender}"
                                       TextAlignment="Center" />
                        </Grid>
                    </Border>
                    <ListBox Classes="table-rows"
                             DoubleTapped="OnShooterRowDoubleTapped"
                             ItemsSource="{Binding Shooters}"
                             Margin="0"
                             SelectedItem="{Binding SelectedShooter}"
                             services:ListBoxSelectService.DeselectOnClick="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ShooterModel">
                                <Grid ColumnSpacing="{DynamicResource SpacingMedium}"
                                      Height="40"
                                      Margin="24,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition SharedSizeGroup="Birthyear"
                                                          Width="Auto" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition SharedSizeGroup="Gender"
                                                          Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Lastname}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Firstname}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Club}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Birthyear}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding Gender, Converter={StaticResource GenderTypeConverter}}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
