<UserControl x:Class="Shoootz.Views.Competition.ShootersView"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Shoootz.Extensions"
             xmlns:models="using:Shoootz.Models.Shooter"
             xmlns:vm="using:Shoootz.ViewModels.Competition"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="vm:ShootersViewModel">

    <UserControl.Resources>
        <loc:EnumConverter x:Key="GenderTypeConverter" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Classes="page-content">

            <TextBlock Classes="h3"
                       Text="{loc:Localization Shooters}" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         HorizontalAlignment="Left"
                         PlaceholderText="{loc:Localization Search}"
                         Text="{Binding SearchText}"
                         Width="300">
                    <TextBox.InnerRightContent>
                        <PathIcon Classes="icon-action icon-danger"
                                  Data="M55.1 73.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L147.2 256 9.9 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192.5 301.3 329.9 438.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.8 256 375.1 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192.5 210.7 55.1 73.4z"
                                  Height="12"
                                  Margin="0,0,10,0"
                                  PointerPressed="OnClearSearchIconPressed"
                                  Width="12"
                                  IsVisible="{Binding HasSearchText}" />
                    </TextBox.InnerRightContent>
                </TextBox>

                <StackPanel Grid.Column="1"
                            Margin="0,0,10,0"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource SpacingMedium}"
                            VerticalAlignment="Center">
                    <PathIcon Classes="icon-action"
                              Data="{DynamicResource AddIcon}"
                              PointerPressed="OnAddIconPressed"
                              VerticalAlignment="Center" />
                    <PathIcon Classes="icon-action"
                              Data="{DynamicResource EditIcon}"
                              PointerPressed="OnEditIconPressed"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding IsShooterSelected}" />
                    <PathIcon Classes="icon-action icon-danger"
                              Data="{DynamicResource DeleteIcon}"
                              PointerPressed="OnDeleteIconPressed"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding IsShooterSelected}" />
                </StackPanel>
            </Grid>

            <Border Classes="card"
                    Padding="0">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <Border Background="{DynamicResource PrimaryBrush}"
                            Padding="24,10">
                        <Grid ColumnSpacing="{DynamicResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition SharedSizeGroup="Birthyear"
                                                  Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition SharedSizeGroup="Gender"
                                                  Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Classes="table-column-header"
                                       Text="{loc:Localization Lastname}" />
                            <TextBlock Grid.Column="1"
                                       Classes="table-column-header"
                                       Text="{loc:Localization Firstname}" />
                            <TextBlock Grid.Column="2"
                                       Classes="table-column-header"
                                       Text="{loc:Localization Club}" />
                            <TextBlock Grid.Column="3"
                                       Classes="table-column-header"
                                       Text="{loc:Localization Birthyear}"
                                       TextAlignment="Center" />
                            <TextBlock Grid.Column="5"
                                       Classes="table-column-header"
                                       Text="{loc:Localization Gender}"
                                       TextAlignment="Center" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="ShootersListBox"
                             Classes="table-rows"
                             DoubleTapped="OnShooterRowDoubleTapped"
                             ItemsSource="{Binding Shooters}"
                             Margin="0"
                             SelectedItem="{Binding SelectedShooter}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ShooterModel">
                                <Grid ColumnSpacing="{DynamicResource SpacingMedium}"
                                      Height="40"
                                      Margin="24,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition SharedSizeGroup="Birthyear"
                                                          Width="Auto" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition SharedSizeGroup="Gender"
                                                          Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Lastname}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Firstname}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Club}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Birthyear}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding Gender, Converter={StaticResource GenderTypeConverter}}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
