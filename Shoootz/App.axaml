<Application x:Class="Shoootz.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:common="using:Shoootz.Common.Views"
             xmlns:icons="using:Controls.Icons"
             xmlns:theme.Lagoon="using:Themes.Lagoon"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <common:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <theme.Lagoon:Lagoon />
        <icons:Icons />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Clicked="OnTrayIconClicked"
                      Icon="/Assets/Logo/Logo.png"
                      ToolTipText="Shoootz">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Click="OnTrayShowClicked" />
                        <NativeMenuItem Click="OnTrayExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>